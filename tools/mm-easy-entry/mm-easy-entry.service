[Unit]
Description=Easy entry: driver's seat back and up at engine off, memory 1 at engine start (SOME/IP through seatctl)
After=vsomeipd.service

[Service]
# root: the vsomeip policy lets uid 0 reach the car's services. The app (its own uid) talks to it over
# /run/mm-easy-entry/ctl.sock (0666). Settings in /var/opt/mm-easy-entry/settings.json (kept over updates).
RuntimeDirectory=mm-easy-entry
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/node /var/opt/mm-easy-entry/current/easyentry.js
Environment=EASY_ENTRY_SEATCTL=/var/opt/mm-easy-entry/current/seatctl
# the car's system.conf has DefaultStandardOutput=null: the log would never reach the journal
StandardOutput=journal
Restart=always
RestartSec=5
Nice=5

[Install]
WantedBy=multi-user.target
